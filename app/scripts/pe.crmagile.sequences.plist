<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Motor de Secuencias — corre cada 15 minutos.
  NO está cargado por default. Para activarlo (always-on):
    cp scripts/pe.crmagile.sequences.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/pe.crmagile.sequences.plist
  Para detenerlo:
    launchctl bootout gui/$(id -u)/pe.crmagile.sequences
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pe.crmagile.sequences</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/luistellesatto/code/crm-agile/app/scripts/sequence-engine.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/luistellesatto/Library/Logs/crm-sequences.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/luistellesatto/Library/Logs/crm-sequences.log</string>
</dict>
</plist>
